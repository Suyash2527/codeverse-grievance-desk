# Copy to .env and fill in. Never commit the filled-in file.
# Only variable NAMES appear here; no value in this file is a real secret.

# --- data ---------------------------------------------------------------
# Directory holding the three supplied CSVs. Replacing a CSV here changes
# system behaviour with no code edit.
DATA_DIR=../data

# --- database -----------------------------------------------------------
# Any Postgres URL: local Docker, Supabase pooler, or AWS RDS in round two.
# Falls back to a local SQLite file when unset, which supports everything
# except pgvector similarity search.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hackfusion

# --- policy -------------------------------------------------------------
# Minimum decision confidence for an automated resolution. Below this, the
# case goes to the human queue.
CONFIDENCE_THRESHOLD=0.75
# Workflow vocabulary, overridable for a replacement dataset.
CLOSING_STATUSES=Resolved,Closed
AI_ALLOWED_STATUSES=Submitted,In Progress,Resolved,Closed

# --- models -------------------------------------------------------------
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- observability ------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- integrations -------------------------------------------------------
# Optional. When unset, webhook dispatch falls back to the recorded mock.
N8N_WEBHOOK_BASE=
